# Postgres (Neon: DATABASE_URL = pooled connection string, DIRECT_URL = direct connection string)
DATABASE_URL=
DIRECT_URL=

# Long random strings. Generate with: openssl rand -base64 48
JWT_SECRET=
OTP_PEPPER=

# Wapix (WhatsApp OTP) - https://www.wapix.sbs/docs
WAPIX_API_KEY=
WAPIX_BASE_URL=https://api.wapix.sbs/api/v1

# RapidAPI - IMDb236
RAPIDAPI_KEY=
RAPIDAPI_HOST=imdb236.p.rapidapi.com
# Optional: which list powers the Discover page (default: /most-popular-movies)
IMDB_BROWSE_PATH=/most-popular-movies

# Local development only: print OTPs to the server console instead of sending them via Wapix.
# Ignored when NODE_ENV=production.
OTP_DEV_LOG=false
